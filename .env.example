# ─── Expo App ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_key_here
EXPO_PUBLIC_API_URL=https://your-api-url.com/api
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_AI_PROXY_URL=https://your-worker.workers.dev
EXPO_PUBLIC_PINECONE_API_KEY=your_pinecone_key
EXPO_PUBLIC_PINECONE_HOST=https://your-index.pinecone.io

# ─── Backend Server (add these to Vercel / Render env vars) ──────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/studyos
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Backblaze B2 (for PDF storage) ─────────────────────────────────────────
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key
B2_BUCKET_NAME=studyos-assignments
